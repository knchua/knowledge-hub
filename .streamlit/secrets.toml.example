# Knowledge Hub local configuration template
#
# DO NOT place real credentials in this example file.
#
# During Milestone 2:
# 1. Copy this file to:
#
#       .streamlit/secrets.toml
#
# 2. Insert the actual credentials from your Supabase project.
#
# The real secrets.toml file is excluded from Git.

[supabase]

url = "https://YOUR_PROJECT.supabase.co"

# Safe for application-level authenticated Supabase operations.
publishable_key = "YOUR_SUPABASE_PUBLISHABLE_KEY"

# Privileged server-side credential.
# NEVER expose this value through the Streamlit UI,
# source repository, application logs, or error messages.
secret_key = "YOUR_SUPABASE_SECRET_KEY"

[app]
base_url = "http://localhost:8501"